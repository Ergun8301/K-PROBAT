{
  // Nom du Worker dans le compte Cloudflare du client.
  "name": "k-probat-site",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,

  // Le Worker sert le site ET reçoit le formulaire (POST /api/devis).
  // Tout le reste est servi depuis site/ via le binding ASSETS.
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // Journal des requêtes : chaque demande de devis y est tracée, donc rien
  // n'est perdu même si le stockage et l'e-mail ne sont pas encore branchés.
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------
  // Options du formulaire (voir MAINTENANCE.md)
  //
  // 1) Enregistrer les demandes — BRANCHÉ.
  //    Espace KV « kprobat-leads » du compte Cloudflare K-ProBat. Les demandes
  //    de devis y sont rangées sous la clé « devis:<date>:<identifiant> » et se
  //    consultent dans Cloudflare → Stockage et bases de données → KV →
  //    kprobat-leads → onglet « Paires KV ».
  "kv_namespaces": [
    { "binding": "LEADS", "id": "458b94871dec4018b304b024d66e28a0" }
  ],

  // 2) Envoyer les demandes par e-mail à l'artisan — BRANCHÉ.
  //    Email Routing est actif sur k-probat.fr et l'adresse de destination
  //    k.probat01@gmail.com est vérifiée dans le compte Cloudflare.
  //    MAIL_FROM doit appartenir à une zone du compte : c'est l'expéditeur
  //    affiché, pas une boîte à relever.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "k.probat01@gmail.com" }
  ],
  // 3) Administration du site (/admin) — BRANCHÉ.
  //    GITHUB_DEPOT n'est PAS une donnée sensible : sa place est ici, dans la
  //    configuration du dépôt. Une variable Texte créée à la main dans le
  //    tableau de bord Cloudflare serait effacée au déploiement suivant.
  //    Seuls ADMIN_MOT_DE_PASSE et GITHUB_TOKEN restent des Secrets.
  "vars": {
    "MAIL_FROM": "site@k-probat.fr",
    "GITHUB_DEPOT": "Ergun8301/K-PROBAT"
  }
  // ---------------------------------------------------------------------
}
